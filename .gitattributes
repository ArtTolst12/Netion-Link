* text=auto
*.kt text eol=lf
*.kts text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
/gradlew text eol=lf
